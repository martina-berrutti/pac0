# @defaultRequired=false
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Firma la cookie de sesión. Obligatoria en producción (Vercel); en desarrollo
# se usa una de prueba si falta.
# @type=string
SESSION_SECRET=

# Google AI Studio (https://aistudio.google.com/apikey). Con esta clave
# andan la voz (Gemini Live), el paciente por texto con IA y el generador.
# Sin clave: paciente por reglas y solo texto.
# @type=string
GEMINI_API_KEY=

# Voz: modelo de Gemini Live y voz del paciente.
# @sensitive=false @type=string
LIVE_MODEL=gemini-3.8-live

# @sensitive=false @type=string
LIVE_VOICE=Kore

# Texto: modelo de Gemini para el paciente por texto y el generador.
# @sensitive=false @type=string
AI_MODEL=gemini-3.8-flash

# Alternativa opcional para el texto si no hay GEMINI_API_KEY.
# @type=string
OPENAI_API_KEY=

# @sensitive=false @type=string
OPENAI_MODEL=gpt-4o-mini

# Para la fase final con Convex (TODO.md). Hoy no se usa.
# @public @type=url
NEXT_PUBLIC_CONVEX_URL=

# Datos en Convex (servidor). Obligatorias en Vercel.
# @type=url @sensitive=false
CONVEX_URL=

# @type=string
STORE_SECRET=

# Login con Google (OAuth).
# @type=string @sensitive=false
GOOGLE_CLIENT_ID=

# @type=string
GOOGLE_CLIENT_SECRET=
